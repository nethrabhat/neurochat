# NeuroChat — environment variable placeholders
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Groq API ──────────────────────────────────────────────────────────────────
# Obtain your key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Model selection ───────────────────────────────────────────────────────────
# Available Groq models (verify at https://console.groq.com/docs/models):
#   llama3-8b-8192        (fast, lower cost)
#   llama3-70b-8192       (higher quality)
#   mixtral-8x7b-32768    (large context window)
#   gemma-7b-it
MODEL_NAME=llama3-8b-8192

# ── Application & Database ───────────────────────────────────────────────────
APP_TITLE=NeuroChat
DB_DIR=./data/neurolinkdb

